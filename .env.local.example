# Clerk (auth) — get from https://dashboard.clerk.com after creating an app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: redirect URLs (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Integrations (wired up in S2 + S3) ---

# Cloudflare API token — Zone:Read, Analytics:Read scope
CLOUDFLARE_API_TOKEN=

# GitHub personal access token (or App token) — repo:read scope
GITHUB_TOKEN=

# PostHog personal API key — read scope; project ID per site set in config/sites.json
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
